{
  "name": "deepseek-cost",
  "version": "1.7.0",
  "type": "module",
  "description": "在输入框下方显示会话人民币费用，计入模型 Token 与网页搜索/抓取费用，点击可查看当前模型价目表并从官方页面更新价格。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zeromixis/deepseek-cost.git"
  },
  "homepage": "https://github.com/Zeromixis/deepseek-cost#readme",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "cost",
    "token"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cost.js",
    "pricing-source.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
